<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required by the `frust-haptics` plugin (the terminal's selection-click
      tick). A NORMAL permission: granted at install with no runtime prompt.
      This is the one manifest addition any plugin in this app needs — the
      `frust` TUI's Add Plugin dialog inserts exactly this line.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Required by the `frust-camera` plugin (the Connect screen's QR pairing
      sheet). A DANGEROUS permission: declaring it here is what makes the
      runtime request the plugin fires (`Camera::request_permission`) legal to
      show at all.

      The plugin's own Gradle module declares this too, and the manifest merger
      would fold it in — but that module is not included in this app's
      `settings.gradle.kts` yet (the plugin README's §2a step), so today this
      declaration is the only one in the merged manifest. It stays either way:
      the merger de-duplicates identical `uses-permission` entries, and an app
      that asks for the camera should say so in its own manifest.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Required to open the gRPC channel to muxrd (TLS over TCP). A NORMAL
      permission: granted at install with no runtime prompt — without it every
      socket connect fails with EPERM.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Muxr">

        <!-- Read by dev.frust.FrustActivity to load this app's Rust library. -->
        <meta-data android:name="dev.frust.nativeLibrary" android:value="muxr" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Muxr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="muxr" />
            </intent-filter>
        </activity>
    </application>

</manifest>